{
  "name": "dsh-token-usage",
  "version": "0.2.0",
  "description": "DSH Token 用量统计面板（Codex 风格）：全实例 Token 消耗汇总 + 活动热力图。",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "echo 'dsh-token-usage: building requires a DeepSeek Harness checkout — see README Development section' && exit 1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "token",
    "usage",
    "stats",
    "heatmap",
    "panel",
    "plugin",
    "codex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-alpha.1",
    "react": "^18.2.0"
  }
}
